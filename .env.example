# These are created automatically when you add a KV (Upstash Redis) storage
# integration to your project in the Vercel dashboard.
# For local development, copy this file to .env.local and paste in the
# values shown in Vercel > Project > Storage > your database > .env.local tab.

KV_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=
